# ===========================================
# APP CONFIGURATION
# ===========================================
APP_NAME="TrensAI CRM"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ===========================================
# DATABASE
# ===========================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wa_crm
DB_USERNAME=root
DB_PASSWORD=password123
DB_ROOT_PASSWORD=password123

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# QUEUE
# ===========================================
QUEUE_CONNECTION=redis
QUEUE_HOST=redis

# ===========================================
# MAIL
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com

# ===========================================
# SESSION
# ===========================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ===========================================
# CACHE
# ===========================================
CACHE_DRIVER=redis
CACHE_REDIS_CONNECTION=default

# ===========================================
# SANCTUM
# ===========================================
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000
SESSION_DOMAIN=localhost
SANCTUM_ENCRYPTION_KEY=

# ===========================================
# SOCKET.IO / REVERB
# ===========================================
REVERB_APP_ID=1
REVERB_APP_KEY=key
REVERB_APP_SECRET=secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# ===========================================
# WHATSAPP ENGINE
# ===========================================
WA_ENGINE_URL=http://wa-engine:3001
WA_ENGINE_API_KEY=your_wa_engine_api_key_here

# ===========================================
# AI ENGINE
# ===========================================
AI_ENGINE_URL=http://ai-engine:3002
AI_ENGINE_API_KEY=your_ai_engine_api_key_here

# Default AI Provider (openai, claude, gemini, ollama)
AI_DEFAULT_PROVIDER=openai

# ===========================================
# OPENAI
# ===========================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# ===========================================
# ANTHROPIC (Claude)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# GOOGLE GEMINI
# ===========================================
GEMINI_API_KEY=AIza...

# ===========================================
# OLLAMA (Local LLM)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===========================================
# JWT
# ===========================================
JWT_SECRET=jwt_secret_key_generate_with_command
JWT_ALGORITHM=HS256
JWT_TTL=60

# ===========================================
# AWS / S3 (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ===========================================
# STRIPE (Optional)
# ===========================================
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ===========================================
# LOG
# ===========================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ===========================================
# DOCKER
# ===========================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
