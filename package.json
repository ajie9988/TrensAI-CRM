{
  "name": "trensai-crm",
  "version": "1.0.0",
  "private": true,
  "description": "TrensAI CRM Monorepo",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "next": "^14.2.15",
      "minimatch": "^9.0.5",
      "glob": "^11.0.0",
      "music-metadata": "^7.14.0",
      "braces": "^3.0.3",
      "ws": "^8.17.1"
    }
  }
}
