{
  "$schema": "https://cdn.jsdelivr.net/npm/release-it@latest/schema.json",
  "git": {
    "requireBranch": "main",
    "requireCommits": false,
    "commit": true,
    "commitMessage": "chore: release v${version}",
    "tag": true,
    "tagName": "v${version}",
    "push": true,
    "pushArgs": "--follow-tags"
  },
  "github": {
    "release": true,
    "draft": false,
    "preRelease": false,
    "releaseName": "Release v${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": "angular",
      "types": [
        {
          "type": "feat",
          "section": "✨ Features"
        },
        {
          "type": "fix",
          "section": "🐛 Bug Fixes"
        },
        {
          "type": "docs",
          "section": "📚 Documentation"
        },
        {
          "type": "perf",
          "section": "⚡ Performance"
        },
        {
          "type": "refactor",
          "section": "♻️ Refactoring"
        },
        {
          "type": "test",
          "section": "✅ Tests"
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "style",
          "hidden": true
        }
      ]
    }
  },
  "hooks": {
    "before:init": [
      "pnpm run lint",
      "pnpm run test"
    ],
    "after:release": "echo Successfully released v${version}"
  }
}
