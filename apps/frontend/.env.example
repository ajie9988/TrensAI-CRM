# TrensAI CRM - Frontend Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (Laravel Reverb / Socket.io)
NEXT_PUBLIC_WS_URL=http://localhost:8000

# App Settings
NEXT_PUBLIC_APP_NAME="TrensAI CRM"
NEXT_PUBLIC_CHAT_REALTIME_METHOD=polling # 'sse' or 'polling'
