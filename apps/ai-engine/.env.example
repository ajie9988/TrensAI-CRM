PORT=3002
NODE_ENV=development

AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# ===================================
# AI BEHAVIOR CONFIGURATION
# ===================================
# System instruction / persona AI
GEMINI_SYSTEM_INSTRUCTION="Anda adalah asisten layanan pelanggan CRM yang ramah."

# Creativity: 0.0 = deterministic, 1.0 = creative
GEMINI_TEMPERATURE=0.7

# Token limit
GEMINI_MAX_OUTPUT_TOKENS=2000

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2

LOG_LEVEL=info
AI_ENGINE_URL=http://127.0.0.1:3002
